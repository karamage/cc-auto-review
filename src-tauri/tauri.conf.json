{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Auto Review",
  "version": "0.2.0",
  "identifier": "dev.cc-auto-review.desktop",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CC Auto Review",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Review GitHub pull requests with Claude Code",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/cc-auto-review-server"
    ],
    "resources": {
      "../dist/client/": "client/",
      "../dist/server/server.js": "server.js"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
